local Functions = {}

function Functions.ClearESP()
    for _, obj in ipairs(ESPInstances) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(ESPInstances)
end

function Functions.ClearGunESP()
    for _, obj in ipairs(GunESPInstances) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(GunESPInstances)
end

function Functions.CreateESP(Player, RoleName, Color)
    if not Player or not Player.Character or Player == LocalPlayer then return end
    local Head = Player.Character:FindFirstChild("Head")
    local Root = Player.Character:FindFirstChild("HumanoidRootPart")
    if not Head or not Root then return end

    local Box = Instance.new("BoxHandleAdornment")
    Box.Name = "VIP_Box"
    Box.Size = Root.Size + Vector3.new(0.1, 0.1, 0.1)
    Box.Visible = ESPToggle
    Box.Adornee = Root
    Box.Color3 = Color
    Box.AlwaysOnTop = true
    Box.ZIndex = 5
    Box.Transparency = 0.5
    Box.Parent = Root
    table.insert(ESPInstances, Box)

    local Bb = Instance.new("BillboardGui")
    Bb.Name = "VIP_ESP"
    Bb.Adornee = Head
    Bb.Size = UDim2.new(0, 140, 0, 35)
    Bb.StudsOffset = Vector3.new(0, 2.5, 0)
    Bb.AlwaysOnTop = true
    Bb.Enabled = ESPToggle
    Bb.Parent = Head

    local TagLabel = Instance.new("TextLabel")
    TagLabel.Size = UDim2.new(1, 0, 1, 0)
    TagLabel.BackgroundTransparency = 1
    TagLabel.Text = Player.Name .. "\n[" .. RoleName .. "]"
    TagLabel.TextColor3 = Color
    TagLabel.Font = Enum.Font.GothamBold
    TagLabel.TextSize = 11
    TagLabel.TextStrokeTransparency = 0
    TagLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    TagLabel.Parent = Bb
    
    table.insert(ESPInstances, Bb)
end

function Functions.UpdateAllESP()
    Functions.ClearESP()
    if not ESPToggle then return end

    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if p == Roles.Murderer then
                Functions.CreateESP(p, "🔪 MURDERER", Color3.fromRGB(255, 40, 40))
            elseif p == Roles.Sheriff then
                Functions.CreateESP(p, "🔫 SHERIFF", Color3.fromRGB(40, 120, 255))
            else
                if InnocentESPToggle then
                    Functions.CreateESP(p, "😇 INNOCENT", Color3.fromRGB(50, 225, 50))
                end
            end
        end
    end
end

-- 🎯 GUN DETECTION
local isTeleporting = false

local function FindDroppedGun()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name == "GunDrop" or v.Name == "NormalGunDrop" then
            if v:IsA("BasePart") then return v end
            if v:IsA("Model") then
                local Part = v:FindFirstChildWhichIsA("BasePart", true)
                if Part then return Part end
            end
        elseif v.Name == "Gun" and v.Parent == workspace then
            if v:IsA("BasePart") then return v end
            if v:IsA("Tool") then
                local Handle = v:FindFirstChild("Handle") or v:FindFirstChildWhichIsA("BasePart")
                if Handle then return Handle end
            end
        end
    end
    return nil
end

function Functions.UpdateGunESP()
    Functions.ClearGunESP()
    if not GunESPToggle then return end

    local GunPart = FindDroppedGun()
    if GunPart then
        local Box = Instance.new("BoxHandleAdornment")
        Box.Name = "Gun_Box"
        Box.Size = Vector3.new(2, 2, 2)
        Box.Visible = true
        Box.Adornee = GunPart
        Box.Color3 = Color3.fromRGB(255, 215, 0)
        Box.AlwaysOnTop = true
        Box.ZIndex = 6
        Box.Transparency = 0.3
        Box.Parent = GunPart
        table.insert(GunESPInstances, Box)

        local Bb = Instance.new("BillboardGui")
        Bb.Name = "Gun_ESP"
        Bb.Adornee = GunPart
        Bb.Size = UDim2.new(0, 120, 0, 30)
        Bb.StudsOffset = Vector3.new(0, 1.5, 0)
        Bb.AlwaysOnTop = true
        Bb.Enabled = true
        Bb.Parent = GunPart

        local TagLabel = Instance.new("TextLabel")
        TagLabel.Size = UDim2.new(1, 0, 1, 0)
        TagLabel.BackgroundTransparency = 1
        TagLabel.Text = "🔫 DROPPED GUN"
        TagLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        TagLabel.Font = Enum.Font.GothamBold
        TagLabel.TextSize = 11
        TagLabel.TextStrokeTransparency = 0
        TagLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        TagLabel.Parent = Bb

        table.insert(GunESPInstances, Bb)
    end
end

local function ProcessAutoPick()
    if not AutoPickGunEnabled or isTeleporting then return end

    local CurrentChar = LocalPlayer.Character
    local RootPart = CurrentChar and CurrentChar:FindFirstChild("HumanoidRootPart")
    if not RootPart then return end

    if CurrentChar:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun") then return end

    local GunPart = FindDroppedGun()
    if GunPart then
        if lastTrackedGun ~= GunPart then
            lastTrackedGun = GunPart
            currentTeleportAttempts = 0
        end

        if currentTeleportAttempts >= maxTeleportAttempts then return end

        isTeleporting = true
        currentTeleportAttempts = currentTeleportAttempts + 1

        local OldCFrame = RootPart.CFrame
        RootPart.CFrame = GunPart.CFrame + Vector3.new(0, 1.5, 0)
        
        Services.StarterGui:SetCore("SendNotification", {
            Title = "🤖 Auto Pick (" .. currentTeleportAttempts .. "/" .. maxTeleportAttempts .. ")", 
            Text = "Attempting gun pickup...", 
            Duration = 1.5
        })
        
        task.wait(0.2)
        RootPart.CFrame = OldCFrame
        task.wait(0.4)
        isTeleporting = false
    else
        lastTrackedGun = nil
        currentTeleportAttempts = 0
    end
end

-- Main Loop
task.spawn(function()
    while task.wait(0.5) do
        Functions.UpdateGunESP()
        if AutoPickGunEnabled then
            ProcessAutoPick()
        end
    end
end)

-- 🎯 SILENT AIM SHOOTING
ShootButton.MouseButton1Click:Connect(function()
    if not Roles.Murderer or not Roles.Murderer.Character then
        Services.StarterGui:SetCore("SendNotification", {Title = "Error", Text = "Murderer not found!", Duration = 2})
        return
    end

    local CurrentChar = LocalPlayer.Character
    if not CurrentChar then return end

    local RootPart = CurrentChar:FindFirstChild("HumanoidRootPart")
    local Gun = CurrentChar:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun")
    
    if not Gun then
        Services.StarterGui:SetCore("SendNotification", {Title = "Error", Text = "No gun in inventory!", Duration = 2})
        return
    end

    if Gun.Parent ~= CurrentChar then
        local Hum = CurrentChar:FindFirstChildOfClass("Humanoid")
        if Hum then
            Hum:EquipTool(Gun)
            task.wait(0.15)
        end
    end

    local TargetPart = Roles.Murderer.Character:FindFirstChild("HumanoidRootPart") or Roles.Murderer.Character.PrimaryPart
    if not TargetPart or not RootPart then return end

    local Attachment = RootPart:FindFirstChild("GunRaycastAttachment")
    local StartCFrame = Attachment and Attachment.WorldCFrame or RootPart.CFrame

    local TargetVelocity = TargetPart.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
    local PredictedPosition = TargetPart.Position + (TargetVelocity / 15)
    local TargetCFrame = CFrame.new(PredictedPosition)

    local ShootRemote = Gun:FindFirstChild("Shoot")
    if ShootRemote and ShootRemote:IsA("RemoteEvent") then
        ShootRemote:FireServer(StartCFrame, TargetCFrame)
        Services.StarterGui:SetCore("SendNotification", {Title = "BOOM! 💥", Text = "Shot fired at Murderer!", Duration = 2})
    end
end)

