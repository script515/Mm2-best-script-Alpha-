-- // Safe GitHub Loader Function \\ --
local function startCoinFarmLoader()
    task.spawn(function()
        local url = "https://raw.githubusercontent.com/Vocal1sScript/AutoFarm/refs/heads/main/Loader.lua"
        
        local success, err = pcall(function()
            local scriptContent = game:HttpGet(url)
            if scriptContent and #scriptContent > 0 then
                local loadedFunc, syntaxErr = loadstring(scriptContent)
                if loadedFunc then
                    loadedFunc()
                else
                    warn("[Loader] Script syntax hatası:", syntaxErr)
                end
            else
                warn("[Loader] GitHub'dan veri çekilemedi.")
            end
        end)

        if not success then
            warn("[Loader] Çalıştırılırken hata oluştu:", err)
        end
    end)
end

