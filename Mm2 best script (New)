-- Role Track Listeners
local function CheckItem(Player, Item)
    if not Item or not Item:IsA("Tool") then return end
    if Item.Name == "Knife" then
        Roles.Murderer = Player
        Functions.UpdateAllESP()
    elseif Item.Name == "Gun" then
        Roles.Sheriff = Player
        Functions.UpdateAllESP()
    end
end

local function TrackPlayer(Player)
    local function CharacterAdded(Char)
        local Backpack = Player:WaitForChild("Backpack", 10)
        if not Backpack then return end

        Roles.InnocentPlayers[Player] = true

        for _, item in ipairs(Backpack:GetChildren()) do CheckItem(Player, item) end
        for _, item in ipairs(Char:GetChildren()) do CheckItem(Player, item) end

        Backpack.ChildAdded:Connect(function(Item) CheckItem(Player, Item) end)
        Char.ChildAdded:Connect(function(Item) CheckItem(Player, Item) end)
        
        task.wait(0.5)
        Functions.UpdateAllESP()
    end

    if Player.Character then CharacterAdded(Player.Character) end
    Player.CharacterAdded:Connect(CharacterAdded)
end

for _, p in ipairs(Services.Players:GetPlayers()) do TrackPlayer(p) end
Services.Players.PlayerAdded:Connect(TrackPlayer)

Services.Players.PlayerRemoving:Connect(function(Player)
    if Roles.Murderer == Player then Roles.Murderer = nil end
    if Roles.Sheriff == Player then Roles.Sheriff = nil end
    Roles.InnocentPlayers[Player] = nil
    Functions.UpdateAllESP()
end)
