    TagLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    TagLabel.Parent = Bb
    
    table.insert(ESPInstances, Bb)
end

function Functions.UpdateAllESP()
    Functions.ClearESP()
    if not ESPToggle then return end

    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if p == Roles.Murderer then
                Functions.CreateESP(p, "🔪 MURDERER", Color3.fromRGB(255, 40, 40))
            elseif p == Roles.Sheriff then
                Functions.CreateESP(p, "🔫 SHERIFF", Color3.fromRGB(40, 120, 255))
            else
                if InnocentESPToggle then
                    Functions.CreateESP(p, "😇 INNOCENT", Color3.fromRGB(50, 225, 50))
                end
            end
        end
    end
end

-- 🎯 GUN FINDER & AUTO TP LOGIC
local isTeleporting = false

local function FindDroppedGun()
    for _, v in ipairs(workspace:GetDescendants()) do
        if (v.Name == "GunDrop" or v.Name == "Gun" or v.Name == "NormalGunDrop") and v:IsA("BasePart") then
            if not v:FindFirstAncestorOfClass("Model"):FindFirstChildOfClass("Humanoid") then
                return v
            end
        elseif v.Name == "GunDrop" and v:IsA("Model") then
            local Part = v:FindFirstChildWhichIsA("BasePart", true)
            if Part then return Part end
        end
    end
    return nil
end

local function ProcessAutoPick()
    if not AutoPickGunEnabled or isTeleporting then return end
    if Roles.Murderer == LocalPlayer then return end

    local CurrentChar = LocalPlayer.Character
    local RootPart = CurrentChar and CurrentChar:FindFirstChild("HumanoidRootPart")
    if not RootPart then return end

    local Map = workspace:FindFirstChild("Normal") or workspace:FindFirstChild("Map")
    if not Map then return end

    local GunPart = FindDroppedGun()
    if GunPart then
        isTeleporting = true
        local OldCFrame = RootPart.CFrame
        
        RootPart.CFrame = GunPart.CFrame + Vector3.new(0, 1, 0)
        Services.StarterGui:SetCore("SendNotification", {Title = "🤖 Auto Pick", Text = "Fetching gun...", Duration = 1.5})
        
        task.wait(0.18)
        
        RootPart.CFrame = OldCFrame
        task.wait(0.5)
        isTeleporting = false
    end
end

workspace.DescendantAdded:Connect(function(descendant)
    if descendant.Name == "GunDrop" or descendant.Name == "NormalGunDrop" or (descendant.Name == "Gun" and descendant.Parent == workspace) then
        task.wait(0.05)
        ProcessAutoPick()
    end
end)

task.spawn(function()
    while task.wait(1) do
        if AutoPickGunEnabled then
            ProcessAutoPick()
        end
    end
end)

